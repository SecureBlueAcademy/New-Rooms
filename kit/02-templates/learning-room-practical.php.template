    <section class="card" id="mission-brief">
        <div class="section-label">Mission briefing</div>
        <h2>{{MISSION_TITLE}}</h2>
        <p>{{MISSION_DESCRIPTION: scenario, hosts, what the learner must achieve. Describe the goal, not the solution.}}</p>
        <ol>
            <li>{{STEP_1}}</li>
            <li>{{STEP_2}}</li>
            <li>{{STEP_3}}</li>
        </ol>
    </section>

    <div class="env-layout">
        <section class="tool-area" id="tool-area">
            <div class="section-label">{{TOOL_AREA_LABEL}}</div>
            <!-- TOOL AREA: build the simulated tool here (viewer, simulated app, decision deck, decoder).
                 Data comes from LAB_DATA below. Every key item needs a benign decoy. -->
            <div class="term" id="tool-output">{{INITIAL_TOOL_OUTPUT}}</div>
            <div class="deck" id="deck"></div>
            <p class="note" style="font-size:.82rem;color:var(--text-muted)">Click cards to add them to your plan in order. Use Reset to start again.</p>
            <ul class="log" id="log"></ul>
        </section>

        <aside class="card" id="submit-card">
