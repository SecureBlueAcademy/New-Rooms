            <label class="field">{{PROOF_FIELD_2_LABEL}}<input type="text" id="ans-2" class="inp" autocomplete="off"></label>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
                <button type="button" class="btn btn-primary" id="btn-submit">Submit</button>
                <button type="button" class="btn" id="btn-reset">Reset</button>
            </div>
            <p id="feedback" style="margin-top:10px;font-size:.9rem"></p>
            <div id="flag-area"><div class="section-label">Flag</div><div id="flag-output"></div></div>
        </aside>
