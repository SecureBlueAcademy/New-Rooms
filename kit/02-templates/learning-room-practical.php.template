        <h3 id="tut-title"></h3>
        <p id="tut-text"></p>
        <div class="tut-nav">
            <button type="button" class="btn" id="tut-prev">Back</button>
            <button type="button" class="btn btn-primary" id="tut-next">Next</button>
        </div>
    </div>
</div>

<script>
(function () {
    'use strict';
    var $ = function (id) { return document.getElementById(id); };

    // ===== LAB DATA (synthetic only: cbx.lab, RFC 5737 / RFC 1918 addresses) =====
    var LAB_DATA = {
        cards: [
            // {id:'c1', text:'{{ACTION_CARD_TEXT}}'}, include trap cards; order is shuffled at load
            { id: 'c1', text: '{{CARD_1}}' },
            { id: 'c2', text: '{{CARD_2}}' },
            { id: 'c3', text: '{{TRAP_CARD_1}}' },
            { id: 'c4', text: '{{CARD_3}}' }
        ],
        // graded order: only boundaries taught in the theory page; cards inside one step may be in any order
        steps: [['c1'], ['c2', 'c4']],
        traps: ['c3'],
        // optional consequence lines, only for taught order boundaries (never name the right card)
        consequence: { 'c3': '{{CONSEQUENCE_LINE_FOR_TRAP}}' }
    };
    var CHECK_HASH = '{{CHECK_HASH_FROM_seal_flag.py}}';
    var SEALED_FLAG_HEX = '{{SEALED_FLAG_HEX_FROM_seal_flag.py}}';
    var TUTORIAL_KEY = '{{SLUG_UNDERSCORED}}_tutorial_seen';
    var TUTORIAL = [
        { t: 'Welcome', x: '{{TUTORIAL_STEP_1: what this tool is}}' },
        { t: 'Read the evidence', x: '{{TUTORIAL_STEP_2: how to use the tool area}}' },
        { t: 'Build your plan', x: '{{TUTORIAL_STEP_3: how cards and Reset work}}' },
        { t: 'Submit', x: '{{TUTORIAL_STEP_4: what to enter and where the flag appears}}' }
    ];

    // ===== FLAG SEAL (do not edit) =====
    function cyrb53(str, seed) {
        var h1 = 0xdeadbeef ^ seed, h2 = 0x41c6ce57 ^ seed;
        for (var i = 0; i < str.length; i++) {
            var ch = str.charCodeAt(i);
            h1 = Math.imul(h1 ^ ch, 2654435761); h2 = Math.imul(h2 ^ ch, 1597334677);
        }
        h1 = Math.imul(h1 ^ (h1 >>> 16), 2246822507) ^ Math.imul(h2 ^ (h2 >>> 13), 3266489909);
        h2 = Math.imul(h2 ^ (h2 >>> 16), 2246822507) ^ Math.imul(h1 ^ (h1 >>> 13), 3266489909);
        return 4294967296 * (2097151 & h2) + (h1 >>> 0);
    }
    function norm(s) { return String(s).trim().toLowerCase().split(/\s+/).join(' '); }
    function unseal(hex, key) {
        var out = '';
        for (var i = 0; i < hex.length; i += 2) {
            out += String.fromCharCode(parseInt(hex.substr(i, 2), 16) ^ (cyrb53(key, i / 2) % 256));
        }
        return out;
    }

    // ===== PLAN DECK =====
    var plan = [];
    function shuffle(a) { for (var i = a.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = a[i]; a[i] = a[j]; a[j] = t; } return a; }
    function log(msg, cls) { var li = document.createElement('li'); li.textContent = msg; if (cls) li.className = cls; $('log').appendChild(li); }
    function renderDeck() {
        var deck = $('deck'); deck.innerHTML = '';
        shuffle(LAB_DATA.cards.slice()).forEach(function (c) {
            var b = document.createElement('button');
            b.type = 'button'; b.className = 'action-card'; b.textContent = c.text; b.dataset.id = c.id;
            b.addEventListener('click', function () {
                if (plan.indexOf(c.id) !== -1) return;
                plan.push(c.id); b.classList.add('chosen'); log((plan.length) + '. ' + c.text);
                if (LAB_DATA.consequence[c.id]) log(LAB_DATA.consequence[c.id], 'bad');
            });
            deck.appendChild(b);
        });
    }
    function planIsValid() {
        if (plan.some(function (id) { return LAB_DATA.traps.indexOf(id) !== -1; })) return false;
        var flat = []; LAB_DATA.steps.forEach(function (s) { flat = flat.concat(s); });
        if (plan.length !== flat.length) return false;
        var pos = 0;
        for (var s = 0; s < LAB_DATA.steps.length; s++) {
            var chunk = plan.slice(pos, pos + LAB_DATA.steps[s].length);
            if (!LAB_DATA.steps[s].every(function (id) { return chunk.indexOf(id) !== -1; })) return false;
            pos += LAB_DATA.steps[s].length;
        }
        return true;
    }
    function reset() {
        plan = []; $('log').innerHTML = ''; $('feedback').textContent = '';
        $('ans-1').value = ''; $('ans-2').value = '';
        $('flag-area').classList.remove('show'); $('flag-output').textContent = '';
        renderDeck();
    }
    function submit() {
        var key = [norm($('ans-1').value), norm($('ans-2').value)].join('|');
        if (cyrb53(key, 7).toString(16) !== CHECK_HASH || !planIsValid()) {
            $('feedback').textContent = 'Not yet.'; $('feedback').style.color = 'var(--error)'; return;
        }
        $('feedback').textContent = 'Accepted.'; $('feedback').style.color = 'var(--success)';
        $('flag-output').textContent = unseal(SEALED_FLAG_HEX, key); $('flag-area').classList.add('show');
    }

    // ===== TUTORIAL =====
    var tStep = 0;
    function showTut(on) {
        $('tutorial').classList.toggle('show', on);
        document.documentElement.classList.toggle('tutorial-active', on);
        document.body.classList.toggle('tutorial-active', on);
        if (on) drawTut(); else { try { localStorage.setItem(TUTORIAL_KEY, '1'); } catch (e) {} }
    }
    function drawTut() {
        $('tut-title').textContent = TUTORIAL[tStep].t; $('tut-text').textContent = TUTORIAL[tStep].x;
        $('tut-prev').disabled = tStep === 0; $('tut-next').textContent = tStep === TUTORIAL.length - 1 ? 'Finish' : 'Next';
    }
    $('tut-prev').addEventListener('click', function () { if (tStep > 0) { tStep--; drawTut(); } });
    $('tut-next').addEventListener('click', function () { if (tStep < TUTORIAL.length - 1) { tStep++; drawTut(); } else showTut(false); });
    $('btn-tutorial').addEventListener('click', function () { tStep = 0; showTut(true); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') showTut(false); });

    $('btn-submit').addEventListener('click', submit);
    $('btn-reset').addEventListener('click', reset);
    renderDeck();
    var seen = false; try { seen = localStorage.getItem(TUTORIAL_KEY) === '1'; } catch (e) {}
    if (!seen) showTut(true);
})();
</script>
</body>
</html>
