<script>
(function () {
    'use strict';
    var $ = function (id) { return document.getElementById(id); };
    var PAGE_SIZE = 25;

    // ===== EVIDENCE (synthetic). Raw fields only. Sorted by time. Include decoys for every key event. =====
    var TABLES = {
        src1: {
            cols: [['ts', 'ts'], ['host', 'host'], ['{{COLUMN_KEY_2}}', '{{COLUMN_LABEL_2}}'], ['{{COLUMN_KEY_3}}', '{{COLUMN_LABEL_3}}']],
            rows: [
                // { ts: '2026-10-14 02:16:55', host: 'srv01', ... }
            ]
        },
        src2: {
            cols: [['ts', 'ts'], ['host', 'host'], ['{{COLUMN_KEY}}', '{{COLUMN_LABEL}}']],
            rows: []
        },
        inv: {
            cols: [['host', 'Host'], ['ip', 'IP'], ['os', 'OS'], ['build', 'Build / patch level']],
            rows: [
                // { host: 'srv01', ip: '10.x.x.x', os: 'Windows Server 2019', build: '17763.xxxx' }
            ]
        }
    };

    // ===== CONSOLE (ordered plan). Groups = graded order boundaries taught in the brief.
    // Steps inside one group are accepted in any order. Traps keep the flag locked. =====
    var STEPS = [
        { id: 's1', text: '{{EVIDENCE_COLLECTION_STEP}}' },
        { id: 's2', text: '{{CONTAIN_STEP_A}}' },
        { id: 's3', text: '{{CONTAIN_STEP_B}}' },
        { id: 's4', text: '{{ERADICATE_STEP}}' },
        { id: 's5', text: '{{RECOVER_AND_MONITOR_STEP}}' },
        { id: 't1', text: '{{TRAP_STEP_1 e.g. delete the file before export}}' },
        { id: 't2', text: '{{TRAP_STEP_2 e.g. reboot before memory capture}}' }
    ];
    var GROUPS = [['s1'], ['s2', 's3'], ['s4'], ['s5']];
    var CHECK_HASH = '{{CHECK_HASH_FROM_seal_flag.py}}';         // key = proof fields p1|p2|p3|p4 normalised
    var SEALED_FLAG_HEX = '{{SEALED_FLAG_HEX_FROM_seal_flag.py}}';
    var TUTORIAL_KEY = '{{SLUG_UNDERSCORED}}_tutorial_seen';
    var TUTORIAL = [
        { t: 'Welcome', x: '{{TUTORIAL_1: what the analyser holds}}' },
        { t: 'Tabs and filters', x: '{{TUTORIAL_2: each tab is one evidence source; filters combine; pages}}' },
        { t: 'Console', x: '{{TUTORIAL_3: proof fields, building the plan, Reset}}' }
    ];

    // ===== FLAG SEAL (do not edit) =====
    function cyrb53(str, seed) {
        var h1 = 0xdeadbeef ^ seed, h2 = 0x41c6ce57 ^ seed;
        for (var i = 0; i < str.length; i++) { var ch = str.charCodeAt(i); h1 = Math.imul(h1 ^ ch, 2654435761); h2 = Math.imul(h2 ^ ch, 1597334677); }
        h1 = Math.imul(h1 ^ (h1 >>> 16), 2246822507) ^ Math.imul(h2 ^ (h2 >>> 13), 3266489909);
        h2 = Math.imul(h2 ^ (h2 >>> 16), 2246822507) ^ Math.imul(h1 ^ (h1 >>> 13), 3266489909);
        return 4294967296 * (2097151 & h2) + (h1 >>> 0);
    }
    function norm(s) { return String(s).trim().toLowerCase().split(/\s+/).join(' '); }
    function unseal(hex, key) { var o = ''; for (var i = 0; i < hex.length; i += 2) o += String.fromCharCode(parseInt(hex.substr(i, 2), 16) ^ (cyrb53(key, i / 2) % 256)); return o; }

    // ===== TABLE RENDERING with filters and full pagination (never capped) =====
    var state = {};
    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
    function filtered(name) {
        var f = state[name].filters;
        return TABLES[name].rows.filter(function (r) {
            return Object.keys(f).every(function (k) { return !f[k] || String(r[k] || '').toLowerCase().indexOf(f[k].toLowerCase()) !== -1; });
        });
    }
    function render(name) {
        var t = TABLES[name], st = state[name], rows = filtered(name);
        var pages = Math.max(1, Math.ceil(rows.length / PAGE_SIZE));
        if (st.page >= pages) st.page = pages - 1;
        $('head-' + name).innerHTML = '<tr>' + t.cols.map(function (c) { return '<th>' + esc(c[1]) + '</th>'; }).join('') + '</tr>';
        $('body-' + name).innerHTML = rows.slice(st.page * PAGE_SIZE, (st.page + 1) * PAGE_SIZE).map(function (r) {
            return '<tr>' + t.cols.map(function (c) { return '<td>' + esc(r[c[0]]) + '</td>'; }).join('') + '</tr>';
        }).join('');
        if ($('count-' + name)) $('count-' + name).textContent = rows.length + ' rows';
        var p = $('pager-' + name); p.innerHTML = '';
        [['First', 0], ['Prev', st.page - 1], ['Next', st.page + 1], ['Last', pages - 1]].forEach(function (b) {
            var btn = document.createElement('button'); btn.type = 'button'; btn.className = 'btn'; btn.textContent = b[0];
            btn.disabled = b[1] < 0 || b[1] >= pages || b[1] === st.page;
            btn.addEventListener('click', function () { st.page = b[1]; render(name); }); p.appendChild(btn);
        });
        var lbl = document.createElement('span'); lbl.textContent = 'Page ' + (st.page + 1) + ' of ' + pages; p.appendChild(lbl);
    }
    Object.keys(TABLES).forEach(function (name) { state[name] = { page: 0, filters: {} }; render(name); });
    document.querySelectorAll('.filters').forEach(function (fb) {
        var name = fb.dataset.table;
        fb.querySelectorAll('input').forEach(function (inp) {
            inp.addEventListener('input', function () { state[name].filters[inp.dataset.col] = inp.value.trim(); state[name].page = 0; render(name); });
        });
    });

    // ===== TABS =====
    document.querySelectorAll('.tab-btn').forEach(function (b) {
        b.addEventListener('click', function () {
            document.querySelectorAll('.tab-btn').forEach(function (x) { x.classList.remove('active'); });
            document.querySelectorAll('.panel').forEach(function (x) { x.classList.remove('active'); });
            b.classList.add('active', 'visited'); $('panel-' + b.dataset.panel).classList.add('active');
        });
    });

    // ===== CONSOLE =====
    var plan = [];
    function shuffle(a) { for (var i = a.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = a[i]; a[i] = a[j]; a[j] = t; } return a; }
    var order = shuffle(STEPS.slice());
    function drawConsole() {
        $('pool').innerHTML = ''; $('plan').innerHTML = '';
        order.forEach(function (s) {
            if (plan.indexOf(s.id) !== -1) return;
            var b = document.createElement('button'); b.type = 'button'; b.className = 'btn step-btn'; b.textContent = s.text;
            b.addEventListener('click', function () { plan.push(s.id); drawConsole(); }); $('pool').appendChild(b);
        });
        plan.forEach(function (id, i) {
            var s = STEPS.filter(function (x) { return x.id === id; })[0];
            var li = document.createElement('li'); li.innerHTML = '<span></span>'; li.firstChild.textContent = s.text;
            var rm = document.createElement('button'); rm.type = 'button'; rm.className = 'btn'; rm.textContent = 'Remove';
            rm.addEventListener('click', function () { plan.splice(i, 1); drawConsole(); }); li.appendChild(rm); $('plan').appendChild(li);
        });
    }
    function planOk() {
        var need = [].concat.apply([], GROUPS);
        if (plan.length !== need.length) return false;
        var pos = 0;
        return GROUPS.every(function (g) { var chunk = plan.slice(pos, pos + g.length); pos += g.length; return g.every(function (id) { return chunk.indexOf(id) !== -1; }); });
    }
    $('btn-submit').addEventListener('click', function () {
        var key = ['p1', 'p2', 'p3', 'p4'].map(function (id) { return norm($(id).value); }).join('|');
        if (cyrb53(key, 7).toString(16) !== CHECK_HASH || !planOk()) { $('feedback').textContent = 'Not yet.'; $('feedback').style.color = 'var(--error)'; return; }
        $('feedback').textContent = 'Accepted.'; $('feedback').style.color = 'var(--success)';
        $('flag-output').textContent = unseal(SEALED_FLAG_HEX, key); $('flag-area').classList.add('show');
    });
    $('btn-reset').addEventListener('click', function () {
        plan = []; order = shuffle(STEPS.slice()); drawConsole();
        document.querySelectorAll('.proof').forEach(function (i) { i.value = ''; });
        $('feedback').textContent = ''; $('flag-area').classList.remove('show'); $('flag-output').textContent = '';
    });
    drawConsole();

    // ===== TUTORIAL =====
    var tStep = 0;
    function drawTut() { $('tut-title').textContent = TUTORIAL[tStep].t; $('tut-text').textContent = TUTORIAL[tStep].x; $('tut-prev').disabled = tStep === 0; $('tut-next').textContent = tStep === TUTORIAL.length - 1 ? 'Finish' : 'Next'; }
    function showTut(on) {
        $('tutorial').classList.toggle('show', on); document.documentElement.classList.toggle('tutorial-active', on); document.body.classList.toggle('tutorial-active', on);
        if (on) drawTut(); else { try { localStorage.setItem(TUTORIAL_KEY, '1'); } catch (e) {} }
    }
    $('tut-prev').addEventListener('click', function () { if (tStep > 0) { tStep--; drawTut(); } });
    $('tut-next').addEventListener('click', function () { if (tStep < TUTORIAL.length - 1) { tStep++; drawTut(); } else showTut(false); });
    $('btn-tutorial').addEventListener('click', function () { tStep = 0; showTut(true); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') showTut(false); });
    var seen = false; try { seen = localStorage.getItem(TUTORIAL_KEY) === '1'; } catch (e) {}
    if (!seen) showTut(true);
})();
</script>
